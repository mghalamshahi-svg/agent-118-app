{
  "expo": {
    "name": "118",
    "slug": "118-voice-app",
    "version": "9.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "برای ضبط پیام صوتی درخواستت به میکروفون نیاز داریم.",
        "NSLocationWhenInUseUsageDescription": "برای پیدا کردن نزدیک‌ترین کسب‌وکارها به موقعیت مکانی‌ات نیاز داریم."
      },
      "bundleIdentifier": "ca.globallink.app118",
      "buildNumber": "9"
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "ca.globallink.app118",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007344"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#007344"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}